    CONTROL         "", IDC_KEYBOARD_COMMANDS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 7, 128, 295, 38
    LTEXT           "", IDC_KEYBOARD_TWO_PANELS_NOTE, 7, 170, 295, 16, SS_NOPREFIX
