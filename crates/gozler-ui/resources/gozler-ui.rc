// The window's resources. Every caption is empty here: WM_INITDIALOG sets
// them from en.json or the chosen language, so English has one source.

#include <windows.h>
#include <commctrl.h>
#include "ids.h"
#include "version.rh"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "gozler-ui.manifest"

IDI_GOZLER ICON "gozler-ui.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION GOZLER_VERSION_NUMBERS
PRODUCTVERSION GOZLER_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "CompanyName", "Synapse N.V."
            VALUE "FileDescription", "Gozler"
            VALUE "FileVersion", GOZLER_VERSION
            VALUE "InternalName", "gozler-ui"
            VALUE "LegalCopyright", "Copyright (C) 2026 Synapse N.V. and Mustafa Ahci"
            VALUE "OriginalFilename", "gozler-ui.exe"
            VALUE "ProductName", "Gozler"
            VALUE "ProductVersion", GOZLER_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 0x04b0
    END
END

// About Gozler: the icon, the version, what Gozler is, the copyright and the
// repository link. The description and the copyright leave room for longer
// translations.
IDD_ABOUT DIALOGEX 0, 0, 240, 103
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_GOZLER, IDC_ABOUT_ICON, 7, 7, 21, 20
    LTEXT           "", IDC_ABOUT_VERSION, 36, 7, 197, 8, SS_NOPREFIX
    LTEXT           "", IDC_ABOUT_DESCRIPTION, 36, 15, 197, 16, SS_NOPREFIX
    LTEXT           "", IDC_ABOUT_COPYRIGHT, 36, 35, 197, 24, SS_NOPREFIX
    CONTROL         "", IDC_ABOUT_LINK, "SysLink", WS_TABSTOP, 36, 63, 197, 8
    DEFPUSHBUTTON   "", IDCANCEL, 183, 82, 50, 14
END

// Search syntax: the search terms, the search functions and the attribute
// letters, in a monospace font, so their columns line up as in a console of
// 80 columns. The text is English in every language, as the syntax is.
IDD_SEARCH_SYNTAX DIALOGEX 0, 0, 380, 270
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_SEARCH_SYNTAX_TEXT, 7, 7, 366, 234, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "", IDCANCEL, 323, 249, 50, 14
END

// The service's report: the text that `gozler --status` prints, in a
// read-only box, with Copy and Close.
IDD_SERVICE_REPORT DIALOGEX 0, 0, 380, 270
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_SERVICE_REPORT_TEXT, 7, 7, 366, 234, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_NOHIDESEL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "", IDC_SERVICE_REPORT_COPY, 269, 249, 50, 14
    DEFPUSHBUTTON   "", IDCANCEL, 323, 249, 50, 14
END

// Custom date: From and To, each a date picker with its own check box, so
// either end can be left open. Each label comes right before its picker, so
// its access key focuses the picker.
IDD_CUSTOM_DATE DIALOGEX 0, 0, 186, 76
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_CUSTOM_DATE_FROM_LABEL, 7, 9, 52, 8
    CONTROL         "", IDC_CUSTOM_DATE_FROM, "SysDateTimePick32", DTS_SHORTDATEFORMAT | DTS_SHOWNONE | WS_TABSTOP, 62, 7, 117, 14
    LTEXT           "", IDC_CUSTOM_DATE_TO_LABEL, 7, 30, 52, 8
    CONTROL         "", IDC_CUSTOM_DATE_TO, "SysDateTimePick32", DTS_SHORTDATEFORMAT | DTS_SHOWNONE | WS_TABSTOP, 62, 28, 117, 14
    DEFPUSHBUTTON   "", IDOK, 75, 55, 50, 14
    PUSHBUTTON      "", IDCANCEL, 129, 55, 50, 14
END

// Custom size: Minimum and Maximum, either of which may stay empty, and the
// unit both are in.
IDD_CUSTOM_SIZE DIALOGEX 0, 0, 186, 97
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_CUSTOM_SIZE_MINIMUM_LABEL, 7, 9, 52, 8
    EDITTEXT        IDC_CUSTOM_SIZE_MINIMUM, 62, 7, 117, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_CUSTOM_SIZE_MAXIMUM_LABEL, 7, 30, 52, 8
    EDITTEXT        IDC_CUSTOM_SIZE_MAXIMUM, 62, 28, 117, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_CUSTOM_SIZE_UNIT_LABEL, 7, 51, 52, 8
    COMBOBOX        IDC_CUSTOM_SIZE_UNIT, 62, 49, 60, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "", IDOK, 75, 76, 50, 14
    PUSHBUTTON      "", IDCANCEL, 129, 76, 50, 14
END

// Settings: the search box across the top, then the page list on the left
// and the shown page on the right, as Everything's Options dialog has them.
// Each page is a child dialog below, which the window places over the hidden
// page area and after the page list in the Tab order.
IDD_SETTINGS DIALOGEX 0, 0, 400, 331
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_SETTINGS_SEARCH, 7, 7, 329, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_SETTINGS_CLEAR_SEARCH, 343, 7, 50, 14, WS_DISABLED
    CONTROL         "", IDC_SETTINGS_PAGES, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SHAREIMAGELISTS | WS_BORDER | WS_TABSTOP, 7, 27, 70, 276
    LTEXT           "", IDC_SETTINGS_PAGE_AREA, 84, 27, 309, 276, NOT WS_VISIBLE
    LTEXT           "", IDC_SETTINGS_NO_MATCH, 84, 29, 309, 16, SS_NOPREFIX | NOT WS_VISIBLE
    PUSHBUTTON      "", IDC_SETTINGS_RESET_ALL, 7, 310, 50, 14
    DEFPUSHBUTTON   "", IDOK, 235, 310, 50, 14
    PUSHBUTTON      "", IDCANCEL, 289, 310, 50, 14
    PUSHBUTTON      "", IDC_SETTINGS_APPLY, 343, 310, 50, 14
END

// Settings > General: the language and how the window shows sizes, icons
// and memory use, then starting and closing.
//
// Each page's sections are a heading, an icon and a title that the window
// places after it, over the section's indented controls, with an etched line
// between two sections.
IDD_SETTINGS_GENERAL DIALOGEX 0, 0, 309, 276
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_GENERAL_HEADING, 0, 0, 309, 12, SS_NOPREFIX
    CONTROL         "", IDC_GENERAL_DISPLAY_ICON, "Static", SS_ICON | SS_CENTERIMAGE, 0, 20, 10, 10
    LTEXT           "", IDC_GENERAL_DISPLAY, 12, 20, 297, 10, SS_NOPREFIX | SS_CENTERIMAGE
    LTEXT           "", IDC_GENERAL_LANGUAGE_LABEL, 7, 34, 80, 8
    COMBOBOX        IDC_GENERAL_LANGUAGE, 91, 32, 120, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_GENERAL_SIZES_LABEL, 7, 52, 80, 8
    COMBOBOX        IDC_GENERAL_SIZES, 91, 50, 120, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "", IDC_GENERAL_SHOW_ICONS, 7, 68, 295, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_GENERAL_SHOW_MEMORY, 7, 80, 295, 10, WS_TABSTOP
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 0, 98, 309, 1
    CONTROL         "", IDC_GENERAL_STARTING_ICON, "Static", SS_ICON | SS_CENTERIMAGE, 0, 106, 10, 10
    LTEXT           "", IDC_GENERAL_STARTING, 12, 106, 297, 10, SS_NOPREFIX | SS_CENTERIMAGE
    AUTOCHECKBOX    "", IDC_GENERAL_SIGN_IN, 7, 118, 295, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_GENERAL_UPDATES, 7, 130, 295, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_GENERAL_KEEP_RUNNING, 7, 142, 295, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_GENERAL_ONE_WINDOW, 7, 154, 295, 10, WS_TABSTOP
    PUSHBUTTON      "", IDC_GENERAL_RESTORE, 259, 262, 50, 14
END

// Settings > Search: how the search box searches.
IDD_SETTINGS_SEARCH DIALOGEX 0, 0, 309, 276
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_SEARCH_HEADING, 0, 0, 309, 12, SS_NOPREFIX
    CONTROL         "", IDC_SEARCH_BOX_GROUP_ICON, "Static", SS_ICON | SS_CENTERIMAGE, 0, 20, 10, 10
    LTEXT           "", IDC_SEARCH_BOX_GROUP, 12, 20, 297, 10, SS_NOPREFIX | SS_CENTERIMAGE
    AUTOCHECKBOX    "", IDC_SEARCH_AS_YOU_TYPE, 7, 32, 295, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_SEARCH_SHOW_ALL, 7, 44, 295, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_SEARCH_SELECT_ON_CLICK, 7, 56, 295, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_SEARCH_SELECT_ON_ACTIVATE, 7, 68, 295, 10, WS_TABSTOP
    PUSHBUTTON      "", IDC_SEARCH_RESTORE, 259, 262, 50, 14
END

// Settings > Context menu: the items of a row's context menu and whether
// the menu shows the selected one, as Everything's Context Menu page has
// them, and the programs that open folders and files. The page puts the
// Use Total Commander link at the right end of the hint's line.
IDD_SETTINGS_CONTEXT_MENU DIALOGEX 0, 0, 309, 276
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_CONTEXT_MENU_HEADING, 0, 0, 309, 12, SS_NOPREFIX
    LTEXT           "", IDC_CONTEXT_MENU_ITEMS_LABEL, 0, 18, 309, 8
    LISTBOX         IDC_CONTEXT_MENU_ITEMS, 0, 28, 309, 68, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_CONTEXT_MENU_ITEM_GROUP_ICON, "Static", SS_ICON | SS_CENTERIMAGE, 0, 100, 10, 10
    LTEXT           "", IDC_CONTEXT_MENU_ITEM_GROUP, 12, 100, 297, 10, SS_NOPREFIX | SS_CENTERIMAGE
    AUTORADIOBUTTON "", IDC_CONTEXT_MENU_SHOW, 7, 112, 295, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "", IDC_CONTEXT_MENU_SHOW_WITH_SHIFT, 7, 124, 295, 10
    AUTORADIOBUTTON "", IDC_CONTEXT_MENU_HIDE, 7, 136, 295, 10
    // WS_GROUP ends the option buttons' group, so the arrow keys stay in it.
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ | WS_GROUP, 0, 150, 309, 1
    CONTROL         "", IDC_CONTEXT_MENU_OPEN_GROUP_ICON, "Static", SS_ICON | SS_CENTERIMAGE, 0, 154, 10, 10
    LTEXT           "", IDC_CONTEXT_MENU_OPEN_GROUP, 12, 154, 297, 10, SS_NOPREFIX | SS_CENTERIMAGE
    LTEXT           "", IDC_CONTEXT_MENU_OPEN_FOLDERS_LABEL, 7, 168, 80, 8
    EDITTEXT        IDC_CONTEXT_MENU_OPEN_FOLDERS, 90, 166, 158, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_CONTEXT_MENU_OPEN_FOLDERS_BROWSE, 252, 166, 50, 14
    LTEXT           "", IDC_CONTEXT_MENU_OPEN_FILES_LABEL, 7, 186, 80, 8
    EDITTEXT        IDC_CONTEXT_MENU_OPEN_FILES, 90, 184, 158, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_CONTEXT_MENU_OPEN_FILES_BROWSE, 252, 184, 50, 14
    LTEXT           "", IDC_CONTEXT_MENU_OPEN_LOCATION_LABEL, 7, 204, 80, 8
    EDITTEXT        IDC_CONTEXT_MENU_OPEN_LOCATION, 90, 202, 158, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_CONTEXT_MENU_OPEN_LOCATION_BROWSE, 252, 202, 50, 14
    LTEXT           "", IDC_CONTEXT_MENU_COMMAND_HINT, 7, 222, 193, 24, SS_NOPREFIX
    CONTROL         "", IDC_CONTEXT_MENU_TOTAL_COMMANDER, "SysLink", WS_TABSTOP, 204, 222, 98, 10
    PUSHBUTTON      "", IDC_CONTEXT_MENU_RESTORE, 259, 262, 50, 14
END

// Settings > Keyboard: the shortcut that shows Gozler from any program,
// and the shortcuts of the window's commands. The Windows key is a check
// box, because the hotkey control cannot enter it.
