// The window's resources. Every caption is empty here: WM_INITDIALOG sets
// them from en.json or the chosen language, so English has one source.

#include <windows.h>
#include <commctrl.h>
#include "ids.h"
#include "version.rh"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "gozler-ui.manifest"

IDI_GOZLER ICON "gozler-ui.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION GOZLER_VERSION_NUMBERS
PRODUCTVERSION GOZLER_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "FileDescription", "Gozler"
            VALUE "FileVersion", GOZLER_VERSION
            VALUE "InternalName", "gozler-ui"
            VALUE "OriginalFilename", "gozler-ui.exe"
            VALUE "ProductName", "Gozler"
            VALUE "ProductVersion", GOZLER_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 0x04b0
    END
END

// About Gozler: the icon, the version, what Gozler is, the copyright and the
// repository link. The two-line texts leave room for longer translations.
IDD_ABOUT DIALOGEX 0, 0, 240, 95
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_GOZLER, IDC_ABOUT_ICON, 7, 7, 21, 20
    LTEXT           "", IDC_ABOUT_VERSION, 36, 7, 197, 8, SS_NOPREFIX
    LTEXT           "", IDC_ABOUT_DESCRIPTION, 36, 15, 197, 16, SS_NOPREFIX
    LTEXT           "", IDC_ABOUT_COPYRIGHT, 36, 35, 197, 16, SS_NOPREFIX
    CONTROL         "", IDC_ABOUT_LINK, "SysLink", WS_TABSTOP, 36, 55, 197, 8
    DEFPUSHBUTTON   "", IDCANCEL, 183, 74, 50, 14
END

// Search syntax: the search terms, the search functions and the attribute
// letters, in a monospace font, so their columns line up as in a console of
// 80 columns. The text is English in every language, as the syntax is.
IDD_SEARCH_SYNTAX DIALOGEX 0, 0, 380, 270
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_SEARCH_SYNTAX_TEXT, 7, 7, 366, 234, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "", IDCANCEL, 323, 249, 50, 14
END

// Custom date: From and To, each a date picker with its own check box, so
// either end can be left open. Each label comes right before its picker, so
// its access key focuses the picker.
IDD_CUSTOM_DATE DIALOGEX 0, 0, 186, 76
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_CUSTOM_DATE_FROM_LABEL, 7, 9, 52, 8
    CONTROL         "", IDC_CUSTOM_DATE_FROM, "SysDateTimePick32", DTS_SHORTDATEFORMAT | DTS_SHOWNONE | WS_TABSTOP, 62, 7, 117, 14
    LTEXT           "", IDC_CUSTOM_DATE_TO_LABEL, 7, 30, 52, 8
    CONTROL         "", IDC_CUSTOM_DATE_TO, "SysDateTimePick32", DTS_SHORTDATEFORMAT | DTS_SHOWNONE | WS_TABSTOP, 62, 28, 117, 14
    DEFPUSHBUTTON   "", IDOK, 75, 55, 50, 14
    PUSHBUTTON      "", IDCANCEL, 129, 55, 50, 14
END

// Custom size: Minimum and Maximum, either of which may stay empty, and the
// unit both are in.
IDD_CUSTOM_SIZE DIALOGEX 0, 0, 186, 97
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_CUSTOM_SIZE_MINIMUM_LABEL, 7, 9, 52, 8
    EDITTEXT        IDC_CUSTOM_SIZE_MINIMUM, 62, 7, 117, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_CUSTOM_SIZE_MAXIMUM_LABEL, 7, 30, 52, 8
    EDITTEXT        IDC_CUSTOM_SIZE_MAXIMUM, 62, 28, 117, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_CUSTOM_SIZE_UNIT_LABEL, 7, 51, 52, 8
    COMBOBOX        IDC_CUSTOM_SIZE_UNIT, 62, 49, 60, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "", IDOK, 75, 76, 50, 14
    PUSHBUTTON      "", IDCANCEL, 129, 76, 50, 14
END

// Settings: the page list on the left and the shown page on the right, as
// Everything's Options dialog has them. Each page is a child dialog below,
// which the window places over the hidden page area and after the page list
// in the Tab order.
IDD_SETTINGS DIALOGEX 0, 0, 400, 311
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LISTBOX         IDC_SETTINGS_PAGES, 7, 7, 70, 276, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_SETTINGS_PAGE_AREA, 84, 7, 309, 276, NOT WS_VISIBLE
    DEFPUSHBUTTON   "", IDOK, 235, 290, 50, 14
    PUSHBUTTON      "", IDCANCEL, 289, 290, 50, 14
    PUSHBUTTON      "", IDC_SETTINGS_APPLY, 343, 290, 50, 14
END

// Settings > General: the language, starting and closing, and what File
// Explorer's commands do.
IDD_SETTINGS_GENERAL DIALOGEX 0, 0, 309, 276
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_GENERAL_HEADING, 0, 0, 309, 12, SS_NOPREFIX
    LTEXT           "", IDC_GENERAL_LANGUAGE_LABEL, 0, 22, 80, 8
    COMBOBOX        IDC_GENERAL_LANGUAGE, 84, 20, 120, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "", IDC_GENERAL_STARTING, 0, 40, 309, 56
    AUTOCHECKBOX    "", IDC_GENERAL_SIGN_IN, 7, 52, 295, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_GENERAL_UPDATES, 7, 64, 295, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_GENERAL_KEEP_RUNNING, 7, 76, 295, 10, WS_TABSTOP
    GROUPBOX        "", IDC_GENERAL_FILE_EXPLORER, 0, 102, 309, 140
    AUTOCHECKBOX    "", IDC_GENERAL_SEARCH_WITH, 7, 114, 295, 10, WS_TABSTOP
    LTEXT           "", IDC_GENERAL_OPEN_FOLDERS_LABEL, 7, 130, 241, 8
    EDITTEXT        IDC_GENERAL_OPEN_FOLDERS, 7, 140, 241, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_GENERAL_OPEN_FOLDERS_BROWSE, 252, 140, 50, 14
    LTEXT           "", IDC_GENERAL_OPEN_FILES_LABEL, 7, 160, 241, 8
    EDITTEXT        IDC_GENERAL_OPEN_FILES, 7, 170, 241, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_GENERAL_OPEN_FILES_BROWSE, 252, 170, 50, 14
    LTEXT           "", IDC_GENERAL_OPEN_LOCATION_LABEL, 7, 190, 241, 8
    EDITTEXT        IDC_GENERAL_OPEN_LOCATION, 7, 200, 241, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "", IDC_GENERAL_OPEN_LOCATION_BROWSE, 252, 200, 50, 14
    PUSHBUTTON      "", IDC_GENERAL_TOTAL_COMMANDER, 7, 220, 100, 14
    PUSHBUTTON      "", IDC_GENERAL_RESTORE, 229, 262, 80, 14
END

// Settings > Search: how the search box searches.
IDD_SETTINGS_SEARCH DIALOGEX 0, 0, 309, 276
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_SEARCH_HEADING, 0, 0, 309, 12, SS_NOPREFIX
    GROUPBOX        "", IDC_SEARCH_BOX_GROUP, 0, 20, 309, 64
    AUTOCHECKBOX    "", IDC_SEARCH_AS_YOU_TYPE, 7, 32, 295, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_SEARCH_SHOW_ALL, 7, 44, 295, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_SEARCH_SELECT_ON_CLICK, 7, 56, 295, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_SEARCH_SELECT_ON_ACTIVATE, 7, 68, 295, 10, WS_TABSTOP
    PUSHBUTTON      "", IDC_SEARCH_RESTORE, 229, 262, 80, 14
END

// Settings > Keyboard: the shortcut that shows Gozler from any program,
// and the shortcuts of the window's commands. The Windows key is a check
// box, because the hotkey control cannot enter it.
IDD_SETTINGS_KEYBOARD DIALOGEX 0, 0, 309, 276
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_KEYBOARD_HEADING, 0, 0, 309, 12, SS_NOPREFIX
    GROUPBOX        "", IDC_KEYBOARD_SHOW_GROUP, 0, 20, 309, 62
    LTEXT           "", IDC_KEYBOARD_SHORTCUT_LABEL, 7, 34, 295, 8
    CONTROL         "", IDC_KEYBOARD_SHORTCUT, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 7, 44, 140, 14
    AUTOCHECKBOX    "", IDC_KEYBOARD_WINDOWS_KEY, 153, 46, 149, 10, WS_TABSTOP
    LTEXT           "", IDC_KEYBOARD_CLOSED_NOTE, 7, 62, 295, 16, SS_NOPREFIX
    GROUPBOX        "", IDC_KEYBOARD_COMMANDS_GROUP, 0, 88, 309, 168
    LTEXT           "", IDC_KEYBOARD_FILTER_LABEL, 7, 102, 150, 8
    EDITTEXT        IDC_KEYBOARD_FILTER, 160, 100, 142, 14, ES_AUTOHSCROLL
    CONTROL         "", IDC_KEYBOARD_COMMANDS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 7, 118, 295, 66
    LTEXT           "", IDC_KEYBOARD_KEYS_LABEL, 7, 190, 236, 8
    LISTBOX         IDC_KEYBOARD_KEYS, 7, 200, 236, 48, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "", IDC_KEYBOARD_ADD, 250, 200, 52, 14
    PUSHBUTTON      "", IDC_KEYBOARD_EDIT, 250, 217, 52, 14
    PUSHBUTTON      "", IDC_KEYBOARD_REMOVE, 250, 234, 52, 14
    PUSHBUTTON      "", IDC_KEYBOARD_RESTORE, 229, 262, 80, 14
END

// Settings > Index: the drives the service indexes, what it holds and the
// service's state. It changes nothing until the service settings plan.
IDD_SETTINGS_INDEX DIALOGEX 0, 0, 309, 276
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_INDEX_HEADING, 0, 0, 309, 12, SS_NOPREFIX
    GROUPBOX        "", IDC_INDEX_DRIVES_GROUP, 0, 20, 309, 110
    CONTROL         "", IDC_INDEX_DRIVES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 7, 32, 295, 92
    GROUPBOX        "", IDC_INDEX_HOLDS_GROUP, 0, 136, 309, 40
    LTEXT           "", IDC_INDEX_HOLDS, 7, 148, 295, 24, SS_NOPREFIX
    GROUPBOX        "", IDC_INDEX_SERVICE_GROUP, 0, 182, 309, 50
    LTEXT           "", IDC_INDEX_SERVICE, 7, 194, 295, 16, SS_NOPREFIX
    LTEXT           "", IDC_INDEX_STATUS_HINT, 7, 214, 295, 8, SS_NOPREFIX
END

// A command's shortcut: the command, and one hotkey control.
IDD_COMMAND_SHORTCUT DIALOGEX 0, 0, 220, 72
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_COMMAND_SHORTCUT_COMMAND, 7, 7, 206, 8, SS_NOPREFIX
    LTEXT           "", IDC_COMMAND_SHORTCUT_LABEL, 7, 21, 206, 8
    CONTROL         "", IDC_COMMAND_SHORTCUT_KEY, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 7, 31, 206, 14
    DEFPUSHBUTTON   "", IDOK, 109, 51, 50, 14
    PUSHBUTTON      "", IDCANCEL, 163, 51, 50, 14
END
