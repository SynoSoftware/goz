    PUSHBUTTON      "", IDC_INCLUDE_MODIFY, 7, 130, 50, 14
    AUTOCHECKBOX    "", IDC_INCLUDE_NEW_DRIVES, 7, 149, 295, 10, WS_TABSTOP
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 0, 164, 309, 1
    CONTROL         "", IDC_INCLUDE_NAMES_GROUP_ICON, "Static", SS_ICON | SS_CENTERIMAGE, 0, 168, 10, 10
    LTEXT           "", IDC_INCLUDE_NAMES_GROUP, 12, 168, 297, 10, SS_NOPREFIX | SS_CENTERIMAGE
    LTEXT           "", IDC_INCLUDE_NAMES_LABEL, 7, 180, 295, 8
    EDITTEXT        IDC_INCLUDE_NAMES, 7, 190, 295, 14, ES_AUTOHSCROLL
    LTEXT           "", IDC_INCLUDE_NAMES_HINT, 7, 207, 295, 16, SS_NOPREFIX
    AUTOCHECKBOX    "", IDC_INCLUDE_HIDDEN, 7, 226, 295, 10, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_INCLUDE_SYSTEM, 7, 238, 295, 10, WS_TABSTOP
    PUSHBUTTON      "", IDC_INCLUDE_RESTORE, 259, 262, 50, 14
END

// Indexed folders: each drive's folders with a check box, and the summary.
IDD_INDEXED_FOLDERS DIALOGEX 0, 0, 300, 250
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_FOLDERS_TREE_LABEL, 7, 7, 286, 8
    CONTROL         "", IDC_FOLDERS_TREE, "SysTreeView32", TVS_HASBUTTONS | TVS_LINESATROOT | TVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 7, 17, 286, 120
    LTEXT           "", IDC_FOLDERS_HINT, 7, 140, 286, 16, SS_NOPREFIX
    LTEXT           "", IDC_FOLDERS_SUMMARY_LABEL, 7, 160, 286, 8
    CONTROL         "", IDC_FOLDERS_SUMMARY, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 7, 170, 286, 52
    DEFPUSHBUTTON   "", IDOK, 189, 229, 50, 14
    PUSHBUTTON      "", IDCANCEL, 243, 229, 50, 14
END

// A command's shortcut: one hotkey control, whose label names the command.
IDD_COMMAND_SHORTCUT DIALOGEX 0, 0, 220, 58
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_COMMAND_SHORTCUT_LABEL, 7, 7, 206, 8
    CONTROL         "", IDC_COMMAND_SHORTCUT_KEY, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 7, 17, 206, 14
    DEFPUSHBUTTON   "", IDOK, 109, 37, 50, 14
    PUSHBUTTON      "", IDCANCEL, 163, 37, 50, 14
END

// An operation's failures: the instruction in the main instruction font,
// the items done, and each entry with its reason.
IDD_FILE_OPERATIONS_FAILED DIALOGEX 0, 0, 380, 230
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_FAILED_INSTRUCTION, 7, 7, 366, 12, SS_NOPREFIX
    LTEXT           "", IDC_FAILED_BODY, 7, 22, 366, 18, SS_NOPREFIX
    CONTROL         "", IDC_FAILED_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 7, 44, 366, 158
    DEFPUSHBUTTON   "", IDCANCEL, 323, 209, 50, 14
END

// Two panels' Copy to folder and Move to folder: what they act on, then the
// destination as text (DESIGN.md: Copy and Move).
IDD_TRANSFER DIALOGEX 0, 0, 280, 58
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_TRANSFER_LINE, 7, 7, 266, 8, SS_NOPREFIX | SS_ENDELLIPSIS
    EDITTEXT        IDC_TRANSFER_PATH, 7, 17, 266, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "", IDOK, 169, 37, 50, 14
    PUSHBUTTON      "", IDCANCEL, 223, 37, 50, 14
END

// Two panels' New folder: the new folder's name (DESIGN.md: New folder).
IDD_NEW_FOLDER DIALOGEX 0, 0, 220, 58
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_NEW_FOLDER_LABEL, 7, 7, 206, 8
    EDITTEXT        IDC_NEW_FOLDER_NAME, 7, 17, 206, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "", IDOK, 109, 37, 50, 14
    PUSHBUTTON      "", IDCANCEL, 163, 37, 50, 14
END
